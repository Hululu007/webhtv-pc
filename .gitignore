# Build outputs
build/
**/build/
# CI/本地发布打包产物（scripts/package_windows.ps1）
/dist/
.dart_tool/
.gradle/
.idea/
*.iml

# Platform/generated outputs
prototypes/flutter_media_kit/.flutter-plugins*
prototypes/flutter_media_kit/linux/flutter/ephemeral/
prototypes/flutter_media_kit/windows/flutter/ephemeral/
prototypes/flutter_media_kit/macos/Flutter/ephemeral/

# Test/runtime residue
coverage/
logs/
tmp/
*.log
.DS_Store

# Python cache
__pycache__/
*.py[cod]

# JVM Spider sidecar：编译中间产物
# （host.jar 提交入库，理由见 sidecars/spider-host-jvm/README.md §2）
sidecars/spider-host-jvm/.build/
*.class

# Locally provisioned Phase 0 toolchains
.local/

# 开发态内置 Node 运行时（lib/services/node_runtime.dart 向上 10 跳查找的落点）
# 打包脚本把 node.exe 下载到 .local/nodejs/（上面已忽略），再复制到仓库根的
# runtime/node/ 以复现发行包布局；那是几十 MB 的二进制，不入库。
# 只锚定仓库根下的 runtime/node/，不写宽泛的 runtime/：其他 runtime 目录可能需入库。
/runtime/node/

# Phase 7 验收脚本的临时输出（不应入库）
tools/phase7/_run.out
tools/phase7/_run.err

# DSH 会话临时日志与 flutter 工具状态（本地过程产物，不入库）
.dsh/
**/.flutter_tool_state

# superpowers sdd 工作区（本地过程产物，不入库）
# 注意：docs/phase6 与 docs/phase8 的 evidence 会引用其中的 progress.md 作为审计轨迹，
# 删除本目录会让那些引用变成悬空指针——所以这里只忽略，不清理。
.superpowers/
